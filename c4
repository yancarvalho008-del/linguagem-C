#include <stdio.h>

int main() {
    int passos, total = 0, horas = 0;

    while (total < 10000) {
        printf("Digite a quantidade de passos da hora: ");
        scanf("%d", &passos);

        total += passos;
        horas++;
    }

    printf("Meta atingida em %d horas.\n", horas);

    return 0;
}
